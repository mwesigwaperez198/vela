# Editorial / Visual CMS (Strapi v5 REST)
VISUAL_CMS_URL=https://cms.da-vela.example
VISUAL_CMS_TOKEN=
# Optional: extra host if Strapi media is served from a CDN
VISUAL_CMS_MEDIA_HOST=

# Commerce engine (Shopify Storefront API; store currency must be UGX)
COMMERCE_CMS_URL=https://da-vela.myshopify.com
COMMERCE_STOREFRONT_TOKEN=
COMMERCE_API_VERSION=2025-01

# Payment webhooks (see lib/payments/providers.ts)
PAYMENT_WEBHOOK_SECRET=

# Persistent CMS + media storage (create a PUBLIC Vercel Blob store)
# Without this, /admin edits cannot survive on Vercel and uploads will fail.
BLOB_READ_WRITE_TOKEN=

# Homepage content
FEATURED_COLLECTION_SLUG=new-arrivals
